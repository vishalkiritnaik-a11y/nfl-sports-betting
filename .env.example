# Copy to .env for local runs (never commit .env). In GitHub, set these as repository secrets/variables.

# Optional: live multi-book odds from https://the-odds-api.com (free tier: 500 credits/month).
ODDS_API_KEY=
# Comma-separated regions: us, us2, uk, eu, au
ODDS_API_REGIONS=us
# 1 = also pull anytime-TD props (event-level; needs a paid plan for a full weekly slate)
ODDS_API_TD_PROPS=0

# Value flag threshold shown by default (percentage points over the no-vig market)
NFLEDGE_MIN_EDGE_PP=3.0
# Number of past seasons shipped to the UI as browsable backtests
NFLEDGE_UI_HISTORY=2
# Optional path overrides
# NFLEDGE_CACHE=.cache
# NFLEDGE_OUT=web/public/data
# NFLEDGE_DB=data/nfledge.sqlite
